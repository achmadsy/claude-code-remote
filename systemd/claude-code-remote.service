[Unit]
Description=Claude Code Remote over Tailscale
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BIND_HOST=127.0.0.1
Environment=TTYD_PORT=7681
Environment=WRAPPER_PORT=7682
Environment=PUBLIC_URL=https://claude.zlink.my.id
Environment=UPLOAD_DIR=/home/ubuntu/claude-code-remote/uploads
EnvironmentFile=/home/ubuntu/.config/claude-code-remote/environment
ExecStart=/home/ubuntu/claude-code-remote/scripts/start-remote-cli.sh
Restart=on-failure
RestartSec=5
KillMode=process
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=2G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
